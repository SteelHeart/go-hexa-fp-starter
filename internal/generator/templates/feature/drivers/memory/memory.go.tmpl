// Package memory implements the persistence of {{.Dir}} in memory.
//
// # Why this driver exists
//
// It is not a test stub: it is the DEFAULT driver of the module, and it is what
// makes the promise of the starter true — `hexa new` then `go run` starts with
// no database, no Docker, nothing. A module whose only driver required
// PostgreSQL would break that promise at the very first module written.
//
// # GUARANTEES
//
//   - **Uniqueness of the reference**: the map is indexed by normalised
//     reference, and `Save` refuses a duplicate with `CodeReferenceTaken` — the
//     same code an SQL driver will return on a constraint violation. That is
//     what makes two drivers genuinely substitutable.
//   - **Concurrency safe**: every read and every write goes through an RWMutex.
//   - **No mutation of the input**: `domain.Record` is a value.
//
// # NON-GUARANTEES
//
//   - **No durability.** Everything disappears when the process stops.
//   - **No sharing between replicas.** Two instances hold two stores, therefore
//     two truths. Uniqueness is guaranteed ONLY within one process.
//   - **No transaction.** A failure after the write does not undo it. This is
//     the costliest NON-guarantee, and the reason this driver is unfit for
//     production.
//   - **Memory grows without end.** No eviction, no bound.
//
// Writing these NON-guarantees is part of delivering a driver: a driver whose
// non-guarantees are unknown will be picked for what it does not do.
package memory

import (
	"context"
	"sync"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// Store retains the records, indexed by normalised reference.
type Store struct {
	mu           sync.RWMutex
	byReference  map[string]domain.Record
}

// New builds an empty store.
func New() *Store {
	return &Store{byReference: make(map[string]domain.Record)}
}

// Save implements ports.SaveRecord.
//
// The refusal of the duplicate is HERE and not in the use case, deliberately.
// The use case already checks uniqueness, but between its check and its write
// there is a window: two simultaneous creations on the same reference both
// cross it. Only the store, which holds the lock, can settle it — exactly like
// an SQL constraint settles it for a relational driver.
func (s *Store) Save(_ context.Context, record domain.Record) result.Result[domain.Record, domain.Error] {
	s.mu.Lock()
	defer s.mu.Unlock()

	key := record.Reference.String()
	if _, exists := s.byReference[key]; exists {
		return result.Err[domain.Record, domain.Error](domain.NewError(
			domain.CodeReferenceTaken,
			"cette référence est déjà utilisée",
		).WithField("reference"))
	}

	s.byReference[key] = record
	return result.Ok[domain.Record, domain.Error](record)
}

// IsTaken implements ports.ReferenceIsTaken.
//
// Absence is NOT an error: it is worth `false`. That is the contract of the
// port.
func (s *Store) IsTaken(_ context.Context, reference domain.Reference) result.Result[bool, domain.Error] {
	s.mu.RLock()
	defer s.mu.RUnlock()

	_, exists := s.byReference[reference.String()]
	return result.Ok[bool, domain.Error](exists)
}

// Count returns the number of records retained.
//
// Exposed for operations and probes, not for the tests: those go through the
// ports, like any other caller.
func (s *Store) Count() int {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return len(s.byReference)
}
