package domain

import (
	"strings"

	"{{.Module}}/internal/pkg/result"
)

// referenceMaxLen borne la longueur d'une référence.
//
// Une borne EXPLICITE plutôt qu'aucune : sans elle, une entrée de plusieurs
// mégaoctets traverserait le domaine jusqu'au stockage, où elle échouerait avec
// un message de pilote au lieu d'un message métier.
const referenceMaxLen = 64

// Reference identifie un enregistrement de {{.Dir}}, normalisée et validée.
//
// Le champ est non exporté : il est IMPOSSIBLE de fabriquer une Reference
// invalide hors de ce paquet. Conséquence directe : une fonction qui reçoit une
// Reference n'a plus à la valider — c'est le type qui le garantit, pas une
// convention.
//
// ⚠️ C'est le VALUE OBJECT de démonstration du gabarit. Le remplacer par le
// concept réel de {{.Dir}} est le premier travail attendu ; en garder la forme
// — construction unique, champ privé, normalisation avant validation — est ce
// que le socle demande.
type Reference struct{ value string }

// NewReference normalise puis valide une référence. C'est le SEUL chemin de
// construction.
//
// Normaliser AVANT de valider, jamais l'inverse : sinon « ABC » et « abc  »
// seraient deux enregistrements distincts, et l'unicité ne voudrait rien dire.
func NewReference(raw string) result.Result[Reference, Error] {
	normalized := strings.ToUpper(strings.TrimSpace(raw))

	invalid := func(reason string) result.Result[Reference, Error] {
		return result.Err[Reference, Error](
			NewError(CodeInvalidReference, reason).WithField("reference"),
		)
	}

	switch {
	case normalized == "":
		return invalid("la référence est obligatoire")
	case len(normalized) > referenceMaxLen:
		return invalid("la référence est trop longue")
	case strings.ContainsAny(normalized, " \t\n"):
		return invalid("la référence ne peut pas contenir d'espace")
	}
	return result.Ok[Reference, Error](Reference{value: normalized})
}

// String retourne la référence normalisée.
func (r Reference) String() string { return r.value }

// IsZero indique une référence non construite.
//
// Utile aux invariants : la valeur zéro d'un type doit être détectable, sinon
// un oubli de construction se propage sans se signaler.
func (r Reference) IsZero() bool { return r.value == "" }
