package domain

import (
	"strings"

	"{{.Module}}/internal/pkg/result"
)

// referenceMaxLen bounds the length of a reference.
//
// An EXPLICIT bound rather than none: without it, an input of several megabytes
// would cross the domain all the way to storage, where it would fail with a
// driver message instead of a business one.
const referenceMaxLen = 64

// Reference identifies a {{.Dir}} record, normalised and validated.
//
// The field is unexported: it is IMPOSSIBLE to build an invalid Reference
// outside this package. Direct consequence: a function that receives a
// Reference no longer has to validate it — the type guarantees it, not a
// convention.
//
// ⚠️ This is the demonstration VALUE OBJECT of the template. Replacing it with
// the real concept of {{.Dir}} is the first piece of work expected; keeping its
// shape — a single construction path, a private field, normalisation before
// validation — is what the starter asks for.
type Reference struct{ value string }

// NewReference normalises then validates a reference. It is the ONLY
// construction path.
//
// Normalise BEFORE validating, never the other way round: otherwise "ABC" and
// "abc  " would be two distinct records, and uniqueness would mean nothing.
func NewReference(raw string) result.Result[Reference, Error] {
	normalized := strings.ToUpper(strings.TrimSpace(raw))

	invalid := func(reason string) result.Result[Reference, Error] {
		return result.Err[Reference, Error](
			NewError(CodeInvalidReference, reason).WithField("reference"),
		)
	}

	switch {
	case normalized == "":
		return invalid("la référence est obligatoire")
	case len(normalized) > referenceMaxLen:
		return invalid("la référence est trop longue")
	case strings.ContainsAny(normalized, " \t\n"):
		return invalid("la référence ne peut pas contenir d'espace")
	}
	return result.Ok[Reference, Error](Reference{value: normalized})
}

// String returns the normalised reference.
func (r Reference) String() string { return r.value }

// IsZero reports a reference that was never constructed.
//
// Useful for invariants: the zero value of a type must be detectable, otherwise
// a forgotten construction propagates without signalling itself.
func (r Reference) IsZero() bool { return r.value == "" }
