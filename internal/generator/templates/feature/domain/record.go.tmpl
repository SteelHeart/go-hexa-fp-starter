package domain

import "time"

// RecordID identifies a record opaquely.
//
// A named type rather than a string: this is what prevents passing a reference
// where an identifier is expected, a confusion the compiler would never see
// between two `string`s.
type RecordID string

// Status enumerates the states of a record.
//
// A CLOSED set, like ErrorCode: adding a state forces its translation to be
// handled everywhere a decision is made on it.
type Status string

// The states of a record.
const (
	StatusPending  Status = "pending"
	StatusActive   Status = "active"
	StatusArchived Status = "archived"
)

// Record is the demonstration aggregate of the template.
//
// All of its fields are exported and it is handled BY VALUE: a method never
// mutates its receiver, it returns a modified copy. That is what makes it
// impossible for a caller to observe a half-transformed aggregate.
type Record struct {
	ID        RecordID
	Reference Reference
	Status    Status
	CreatedAt time.Time
}

// NewRecord builds a brand new record.
//
// The instant comes from the caller, not from `time.Now()`: the domain never
// reads the clock (golden rule of the starter), and a test that read it would
// fail one day, for no reason.
//
// The initial state is ALWAYS `pending`, never `active`. An aggregate born
// active would short circuit every later validation step — and that kind of
// defect is not seen in review, only in production.
func NewRecord(id RecordID, reference Reference, now time.Time) Record {
	return Record{
		ID:        id,
		Reference: reference,
		Status:    StatusPending,
		CreatedAt: now.UTC(),
	}
}

// WithStatus returns a COPY carrying the new state.
func (r Record) WithStatus(status Status) Record {
	r.Status = status
	return r
}
