package tests

import (
	"errors"
	"strings"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestErrorNeverLeaksTheTechnicalCause: the technical cause is loggable, never
// readable in the returned message.
//
// A driver error sent back to the caller is a leak of the structure: a table
// name, a constraint name, sometimes a fragment of a query. The user message
// and the technical detail are therefore two distinct paths, and this test
// verifies that they meet nowhere.
//
// It also verifies that `WithCause` and `WithField` return COPIES: otherwise,
// enriching one error would modify another one already gone elsewhere.
func TestErrorNeverLeaksTheTechnicalCause(t *testing.T) {
	t.Parallel()

	secret := errors.New("pq: duplicate key value violates unique constraint \"records_reference_key\"")
	base := domain.NewError(domain.CodeInternal, "une erreur interne est survenue")
	enriched := base.WithCause(secret).WithField("reference")

	if strings.Contains(enriched.Error(), "constraint") {
		t.Errorf("the returned message contains the technical detail: %q", enriched.Error())
	}
	if !errors.Is(enriched.Cause(), secret) {
		t.Error("the cause must stay reachable for logging")
	}
	if base.Cause() != nil || base.Field != "" {
		t.Error("the original error was mutated: WithCause/WithField must copy")
	}
	if !strings.Contains(enriched.Error(), "reference") {
		t.Errorf("the faulty field must appear: %q", enriched.Error())
	}
}
