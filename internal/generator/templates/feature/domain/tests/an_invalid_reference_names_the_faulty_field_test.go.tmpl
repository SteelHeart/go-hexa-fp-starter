package tests

import (
	"strings"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestAnInvalidReferenceNamesTheFaultyField: every refusal carries its code AND
// the faulty field.
//
// The field is not an ornament: without it, an HTTP surface can only return a
// "422, somewhere". The user guesses, and so does support.
//
// The three cases cover the three refusal branches. An unexercised branch is a
// branch nobody knows whether it refuses or lets through.
func TestAnInvalidReferenceNamesTheFaultyField(t *testing.T) {
	t.Parallel()

	cases := map[string]string{
		"empty":            "   ",
		"too long":         strings.Repeat("X", 65),
		"contains a space": "ABC 123",
	}

	for name, raw := range cases {
		t.Run(name, func(t *testing.T) {
			t.Parallel()
			err := failureOf(t, domain.NewReference(raw))

			if err.Code != domain.CodeInvalidReference {
				t.Errorf("code = %q, want %q", err.Code, domain.CodeInvalidReference)
			}
			if err.Field != "reference" {
				t.Errorf("field = %q, want \"reference\"", err.Field)
			}
			if err.Message == "" {
				t.Error("a refusal with no message says nothing to the user")
			}
		})
	}
}
