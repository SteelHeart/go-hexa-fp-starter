package tests

import (
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestZeroReferenceIsDetectable: the zero value is recognisable.
//
// Go offers no way to forbid `var r domain.Reference`. The only protection is
// for that state to be DETECTABLE, otherwise a forgotten construction
// propagates all the way to storage without ever signalling itself — and the
// faulty record is written before anybody notices.
func TestZeroReferenceIsDetectable(t *testing.T) {
	t.Parallel()

	var zero domain.Reference
	if !zero.IsZero() {
		t.Error("the zero value must be recognisable")
	}
	if zero.String() != "" {
		t.Errorf("String() = %q, want the empty string", zero.String())
	}

	if validReference(t, "ABC-123").IsZero() {
		t.Error("a constructed reference is not the zero value")
	}
}
