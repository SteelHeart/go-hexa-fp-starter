package tests

import "testing"

// TestReferenceIsNormalised: the reference is upper-cased and stripped of its
// surrounding spaces.
//
// Without normalisation, `abc ` and `ABC` would be TWO distinct records. The
// user would not understand why their search fails, and the uniqueness index in
// the database would bear on variants rather than on a canonical form —
// therefore guaranteeing nothing any more.
func TestReferenceIsNormalised(t *testing.T) {
	t.Parallel()

	cases := map[string]string{
		"lower case":         "abc-123",
		"surrounding spaces": "  ABC-123  ",
		"both":               "\tabc-123 \n",
		"already normalised": "ABC-123",
	}

	for name, raw := range cases {
		t.Run(name, func(t *testing.T) {
			t.Parallel()
			if got := validReference(t, raw).String(); got != "ABC-123" {
				t.Errorf("NewReference(%q) = %q, want the canonical form", raw, got)
			}
		})
	}
}
