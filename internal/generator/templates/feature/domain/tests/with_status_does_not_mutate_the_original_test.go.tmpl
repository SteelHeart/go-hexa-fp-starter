package tests

import (
	"testing"
	"time"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestWithStatusDoesNotMutateTheOriginal: `WithStatus` returns a COPY.
//
// This is immutability by value, and it gets verified rather than assumed: if
// `WithStatus` mutated its receiver, a caller holding a reference to the
// original aggregate would see its state change underneath — without a single
// line of code on their side to explain it.
func TestWithStatusDoesNotMutateTheOriginal(t *testing.T) {
	t.Parallel()

	original := domain.NewRecord("id-1", validReference(t, "ABC-123"), time.Unix(0, 0))
	duplicate := original.WithStatus(domain.StatusArchived)

	if original.Status != domain.StatusPending {
		t.Errorf("the original was mutated: status = %q", original.Status)
	}
	if duplicate.Status != domain.StatusArchived {
		t.Errorf("the copy carries %q, want %q", duplicate.Status, domain.StatusArchived)
	}
	if duplicate.ID != original.ID || duplicate.Reference != original.Reference {
		t.Error("the copy must keep the other fields identical")
	}
}
