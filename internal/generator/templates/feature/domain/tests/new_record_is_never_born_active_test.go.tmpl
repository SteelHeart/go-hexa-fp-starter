package tests

import (
	"testing"
	"time"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestNewRecordIsNeverBornActive: a brand new record is born `pending`, and its
// instant is normalised to UTC.
//
// The initial state is a security decision, not a convention. An aggregate born
// `active` would short circuit every later validation step — and that defect is
// not seen in review, only in production.
//
// UTC avoids the other class of defect: two records created in the same second
// from two time zones must not order differently depending on who reads them.
func TestNewRecordIsNeverBornActive(t *testing.T) {
	t.Parallel()

	paris := time.FixedZone("CEST", 2*60*60)
	instant := time.Date(2026, time.July, 28, 9, 30, 0, 0, paris)

	record := domain.NewRecord("id-1", validReference(t, "ABC-123"), instant)

	if record.Status != domain.StatusPending {
		t.Errorf("status = %q, want %q", record.Status, domain.StatusPending)
	}
	if record.CreatedAt.Location() != time.UTC {
		t.Errorf("CreatedAt in %v, want UTC", record.CreatedAt.Location())
	}
	if !record.CreatedAt.Equal(instant) {
		t.Error("normalisation to UTC must not move the instant")
	}
}
