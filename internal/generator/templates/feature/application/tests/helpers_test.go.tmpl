// Package tests holds the BLACK BOX tests of the {{.Dir}} use cases.
//
// # No mocking library, and that is not a deprivation
//
// Every port is a FUNCTION TYPE: a double is therefore a three-line closure,
// written where it is read. No generation, no `.On("Save")`, no call assertion
// that breaks at the first rename.
//
// This is the direct counterpart of the decision "a port is a function type"
// (ADR 003): it is paid for in declaration verbosity and it pays back here.
package tests

import (
	"context"
	"testing"
	"time"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// fixedInstant is the clock of the tests. Fixed, so the assertions do not
// depend on the moment the suite runs.
var fixedInstant = time.Date(2026, time.July, 28, 10, 0, 0, 0, time.UTC)

// passingDeps returns a set of dependencies whose every step succeeds.
//
// Each test starts from there and REPLACES the single step it cares about: what
// differs from the nominal case is then visible in the test itself, without
// having to compare two mounts.
func passingDeps() application.Deps {
	return application.Deps{
		ReferenceIsTaken: func(context.Context, domain.Reference) result.Result[bool, domain.Error] {
			return result.Ok[bool, domain.Error](false)
		},
		SaveRecord: func(_ context.Context, r domain.Record) result.Result[domain.Record, domain.Error] {
			return result.Ok[domain.Record, domain.Error](r)
		},
		GenerateID: func() domain.RecordID { return "fixed-id" },
		Now:        func() time.Time { return fixedInstant },
	}
}

// successOf discriminates a Result expected to be a success.
func successOf(t *testing.T, r result.Result[domain.Record, domain.Error]) domain.Record {
	t.Helper()
	value, err, ok := r.Get()
	if !ok {
		t.Fatalf("a success was expected, refused: %v", err)
	}
	return value
}

// failureOf discriminates a Result expected to be a failure.
func failureOf(t *testing.T, r result.Result[domain.Record, domain.Error]) domain.Error {
	t.Helper()
	_, err, ok := r.Get()
	if ok {
		t.Fatal("a failure was expected, got a success")
	}
	return err
}
