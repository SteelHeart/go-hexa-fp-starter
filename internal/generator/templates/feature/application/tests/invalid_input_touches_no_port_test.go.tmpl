package tests

import (
	"context"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// TestInvalidInputTouchesNoPort: an invalid input reaches NO port.
//
// This is the property the short circuit of the pipeline is supposed to
// guarantee, and it gets observed rather than assumed: both ports are replaced
// by closures that fail the test if they are called.
//
// Without this test, an inversion of the steps — checking uniqueness before
// validating — would go unnoticed. It would send a request to storage for every
// faulty input, which is a cost, and above all a free attack surface.
func TestInvalidInputTouchesNoPort(t *testing.T) {
	t.Parallel()

	deps := passingDeps()
	deps.ReferenceIsTaken = func(context.Context, domain.Reference) result.Result[bool, domain.Error] {
		t.Error("uniqueness must not be queried on an invalid input")
		return result.Ok[bool, domain.Error](false)
	}
	deps.SaveRecord = func(_ context.Context, r domain.Record) result.Result[domain.Record, domain.Error] {
		t.Error("nothing must be written on an invalid input")
		return result.Ok[domain.Record, domain.Error](r)
	}

	err := failureOf(t, application.NewCreateRecord(deps)(context.Background(), "  "))
	if err.Code != domain.CodeInvalidReference {
		t.Errorf("code = %q, want %q", err.Code, domain.CodeInvalidReference)
	}
}
