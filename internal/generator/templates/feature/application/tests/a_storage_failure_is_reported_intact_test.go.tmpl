package tests

import (
	"context"
	"errors"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// TestAStorageFailureIsReportedIntact: a storage failure comes back up as it
// is, neither swallowed nor retranslated.
//
// This is the costliest fault of a pipeline: a step that catches an error and
// returns a degraded success. The caller then receives 201, the user believes
// their record was created, and nobody discovers otherwise before the next
// stocktake.
//
// The technical cause must survive the passage — it is what will make diagnosis
// possible — without ever entering the returned message.
func TestAStorageFailureIsReportedIntact(t *testing.T) {
	t.Parallel()

	outage := errors.New("storage connection lost")
	deps := passingDeps()
	deps.SaveRecord = func(context.Context, domain.Record) result.Result[domain.Record, domain.Error] {
		return result.Err[domain.Record, domain.Error](
			domain.NewError(domain.CodeUnavailable, "le service est momentanément indisponible").
				WithCause(outage),
		)
	}

	err := failureOf(t, application.NewCreateRecord(deps)(context.Background(), "ABC-123"))

	if err.Code != domain.CodeUnavailable {
		t.Errorf("code = %q, want %q", err.Code, domain.CodeUnavailable)
	}
	if !errors.Is(err.Cause(), outage) {
		t.Error("the technical cause must survive the passage through the use case")
	}
}
