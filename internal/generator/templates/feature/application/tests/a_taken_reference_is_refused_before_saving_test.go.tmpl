// TestATakenReferenceIsRefusedBeforeSaving: the uniqueness refusal falls BEFORE
// the write.
//
// The order matters for two reasons. The first is economic: writing only to be
// refused by a constraint costs a round trip and an aborted transaction. The
// second one matters more — the error code returned to the client must be the
// one of the DOMAIN, not the translation of a constraint violation, otherwise
// two drivers do not return the same thing on the same fault.
func TestATakenReferenceIsRefusedBeforeSaving(t *testing.T) {
	t.Parallel()

	deps := passingDeps()
	deps.ReferenceIsTaken = func(context.Context, domain.Reference) result.Result[bool, domain.Error] {
		return result.Ok[bool, domain.Error](true)
	}
	deps.SaveRecord = func(_ context.Context, r domain.Record) result.Result[domain.Record, domain.Error] {
		t.Error("nothing must be written when the reference is already taken")
		return result.Ok[domain.Record, domain.Error](r)
	}

	err := failureOf(t, application.NewCreateRecord(deps)(context.Background(), "ABC-123"))

	if err.Code != domain.CodeReferenceTaken {
		t.Errorf("code = %q, want %q", err.Code, domain.CodeReferenceTaken)
	}
	if err.Field != "reference" {
		t.Errorf("field = %q, want \"reference\" — otherwise the surface cannot say WHAT to fix", err.Field)
	}
}
