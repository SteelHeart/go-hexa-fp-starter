package tests

import (
	"context"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestClockAndIDComeFromPorts: the instant and the identifier come from the
// ports, never from the `time` package nor from a hidden generator.
//
// That is what makes the use case deterministic: the test fixes both and
// compares exact values, with no tolerance and no `time.Since`. A test that has
// to tolerate a margin is a test that will fail one day on a loaded machine.
//
// And it is the golden rule of the starter made verifiable: `application/` does
// not read the clock.
func TestClockAndIDComeFromPorts(t *testing.T) {
	t.Parallel()

	record := successOf(t, application.NewCreateRecord(passingDeps())(context.Background(), "abc-123"))

	if record.ID != domain.RecordID("fixed-id") {
		t.Errorf("ID = %q, want the one returned by the port", record.ID)
	}
	if !record.CreatedAt.Equal(fixedInstant) {
		t.Errorf("CreatedAt = %v, want the injected instant %v", record.CreatedAt, fixedInstant)
	}
	if record.Reference.String() != "ABC-123" {
		t.Errorf("the reference must be normalised by the domain, got %q", record.Reference)
	}
	if record.Status != domain.StatusPending {
		t.Errorf("status = %q, want %q", record.Status, domain.StatusPending)
	}
}
