// Package application composes the use cases of {{.Dir}}.
//
// It does not log and it does not read the clock: it reports through a port and
// receives its instant. That is what keeps it testable without analysing logs,
// and deterministic without waiting.
package application

import (
	"context"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/modules/{{.Dir}}/ports"
	"{{.Module}}/internal/pkg/result"
)

// Deps carries the secondary ports of the use case.
//
// A type rather than four parameters: beyond two, parameters of the same nature
// get swapped silently — and the `arch-go` maxParameters rule would refuse it
// anyway.
type Deps struct {
	ReferenceIsTaken ports.ReferenceIsTaken
	SaveRecord       ports.SaveRecord
	GenerateID       ports.GenerateID
	Now              ports.Now
}

// NewCreateRecord composes the creation use case.
//
// The ORDER of the steps is the decision, and it reads straight from the code:
// validate, then check uniqueness, then and only then write. An inversion would
// write before validating — that is, persist a faulty input.
//
// The pipeline short circuits: `FlatMap` only calls the next step on an `Ok`.
// No port is therefore touched when the input is invalid, and that is verified
// by a test rather than assumed.
func NewCreateRecord(deps Deps) ports.CreateRecord {
	return func(ctx context.Context, rawReference string) result.Result[domain.Record, domain.Error] {
		return result.FlatMap(
			domain.NewReference(rawReference),
			func(reference domain.Reference) result.Result[domain.Record, domain.Error] {
				return result.FlatMap(
					deps.ReferenceIsTaken(ctx, reference),
					func(taken bool) result.Result[domain.Record, domain.Error] {
						if taken {
							return result.Err[domain.Record, domain.Error](referenceTaken())
						}
						return deps.SaveRecord(ctx, deps.build(reference))
					},
				)
			},
		)
	}
}

// build makes the aggregate out of the pure effect ports.
//
// Isolated so that `NewCreateRecord` stays under the `arch-go` line threshold,
// and because it names the single place in the module where the identifier and
// the instant enter the domain.
func (d Deps) build(reference domain.Reference) domain.Record {
	return domain.NewRecord(d.GenerateID(), reference, d.Now())
}

// referenceTaken names the uniqueness refusal.
//
// The field is filled in: an HTTP surface must be able to say WHICH field is at
// fault, otherwise the user receives "conflict" and has to guess.
func referenceTaken() domain.Error {
	return domain.NewError(
		domain.CodeReferenceTaken,
		"cette référence est déjà utilisée",
	).WithField("reference")
}
