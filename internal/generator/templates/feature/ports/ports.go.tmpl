// Package ports declares the contracts of the {{.Dir}} module.
//
// This package contains ONLY type declarations: no struct, no function, no
// interface (verified by arch-go.yml). A port is a function type — the smallest
// possible interface, therefore nothing left to segregate (ADR 003).
//
// Every secondary port carries its ERROR CONTRACT in a comment. That is the
// operational form of substitutability: two drivers returning different codes
// on the same fault would not be interchangeable, whatever their signature.
package ports

import (
	"context"
	"time"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// ─── Primary ports: what the outside world may ask for ──────────────────────

// CreateRecord records a new {{.Dir}} item.
//
// Every surface calls THIS function: HTTP, CLI, event consumer. Adding a
// surface does not change its signature (ADR 005).
//
// Errors: CodeInvalidReference · CodeReferenceTaken · CodeUnavailable ·
// CodeInternal.
type CreateRecord = func(
	ctx context.Context,
	rawReference string,
) result.Result[domain.Record, domain.Error]

// ─── Secondary ports: what the core needs from the world ────────────────────

// SaveRecord persists a brand new record.
//
// Error contract — every implementation MUST honour it:
//   - CodeReferenceTaken if the uniqueness constraint is violated
//   - CodeUnavailable    if storage is unreachable or the request is cancelled
//   - CodeInternal       for everything else, with the cause attached
//
// No driver error must come back up as it is.
type SaveRecord = func(
	ctx context.Context,
	record domain.Record,
) result.Result[domain.Record, domain.Error]

// ReferenceIsTaken reports whether a reference is already in use.
//
// Error contract: CodeUnavailable · CodeInternal. The absence of a row is NOT
// an error — it is worth `false`.
type ReferenceIsTaken = func(
	ctx context.Context,
	reference domain.Reference,
) result.Result[bool, domain.Error]

// ─── Pure effect ports: the clock and randomness ────────────────────────────

// Now returns the current instant.
//
// It is a port PRECISELY so that the tests are deterministic: a test that reads
// the real clock is a test that will fail one day, for no reason.
type Now = func() time.Time

// GenerateID produces a record identifier.
type GenerateID = func() domain.RecordID
