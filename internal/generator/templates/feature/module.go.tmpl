// Package {{.Package}} is the composition root of the {{.Dir}} module.
//
// It is the ONLY file of the module that knows the drivers (ADR 012). The use
// case itself only ever sees function types: changing driver does not touch a
// single line of `application/` nor of `domain/`.
//
// The module stays deletable with a single `rm -rf`: no code of the starter
// names it, and the only lines to remove are the one in the application
// catalogue and its mounting in the composition root.
package {{.Package}}

import (
	"context"
	"errors"
	"fmt"
	"time"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/modules/{{.Dir}}/drivers/memory"
	"{{.Module}}/internal/modules/{{.Dir}}/ports"
	"{{.Module}}/internal/pkg/result"
)

// Name is the name of the module, as it appears in config/modules.yaml.
const Name = "{{.Dir}}"

// Available persistence drivers.
//
// `memory` is the default, and that is a decision: it requires no
// infrastructure, therefore `go run` starts. See the NON-guarantees of the
// drivers/memory package before considering it anywhere but in development.
const (
	DriverMemory = "memory"
)

// Module exposes the primary ports.
//
// A surface — HTTP, CLI, event consumer — receives ONLY this structure. It
// therefore cannot reach a driver, nor open a transaction, nor bypass the use
// case.
type Module struct {
	Create ports.CreateRecord
}

// Deps carries the effects the module does not make itself.
//
// All of them are function types: in a test, each one is a three-line closure,
// and no mocking library is needed — therefore none is allowed.
type Deps struct {
	// GenerateID and Now are ports so that the tests are deterministic.
	GenerateID ports.GenerateID
	Now        ports.Now
}

// Errors of the module.
var (
	// ErrDisabled signals a call to a disabled module.
	//
	// A disabled module fails explicitly rather than falling back on inert
	// behaviour: an effect silently ignored is the worst possible defect,
	// because it never signals itself.
	ErrDisabled = errors.New("module {{.Dir}} disabled")

	// ErrMissingDependency refuses an incomplete mount.
	ErrMissingDependency = errors.New("required dependency missing")

	errUnknownDriver = errors.New("unknown {{.Dir}} driver")
)

// New builds the module according to the requested driver.
//
// An unknown driver REFUSES to start: a typo is never resolved into "the
// closest driver". Deny by default.
func New(driver string, deps Deps) (Module, error) {
	if err := deps.validate(); err != nil {
		return Module{}, err
	}
	if driver == "" {
		driver = DriverMemory
	}

	switch driver {
	case DriverMemory:
		return assemble(memory.New(), deps), nil
	default:
		return Module{}, fmt.Errorf("%w: %q", errUnknownDriver, driver)
	}
}

// validate refuses an incomplete mount BEFORE any construction.
//
// Without that refusal, a forgotten dependency would produce a nil pointer
// panic on the first real request — therefore in production, and with a stack
// trace that does not say which one was missing.
func (d Deps) validate() error {
	missing := map[string]bool{
		"GenerateID": d.GenerateID == nil,
		"Now":        d.Now == nil,
	}
	for name, absent := range missing {
		if absent {
			return fmt.Errorf("%w: %s", ErrMissingDependency, name)
		}
	}
	return nil
}

// store is what the module expects from a persistence driver.
//
// Declared here and not in `ports/`: it is a convenience of internal
// composition, not a public contract. The ports of the module stay function
// types, and it is `assemble` that extracts the methods from it.
type store interface {
	Save(context.Context, domain.Record) result.Result[domain.Record, domain.Error]
	IsTaken(context.Context, domain.Reference) result.Result[bool, domain.Error]
}

// assemble plugs a driver into the use cases.
func assemble(s store, deps Deps) Module {
	return Module{
		Create: application.NewCreateRecord(application.Deps{
			ReferenceIsTaken: s.IsTaken,
			SaveRecord:       s.Save,
			GenerateID:       deps.GenerateID,
			Now:              deps.Now,
		}),
	}
}

// Disabled returns a module that refuses when called.
//
// It always mounts: that is what lets a surface exist and answer a clear error,
// rather than failing the whole start-up of the server for a module nobody
// enabled.
func Disabled() Module {
	refuse := func(context.Context, string) result.Result[domain.Record, domain.Error] {
		return result.Err[domain.Record, domain.Error](disabledError())
	}
	return Module{Create: refuse}
}

func disabledError() domain.Error {
	return domain.NewError(
		domain.CodeUnavailable,
		"{{.Dir}} est indisponible",
	).WithCause(ErrDisabled)
}

// SystemClock is the real clock, to be passed in production.
//
// Named rather than written `time.Now` at the call site: the composition root
// is the ONLY place in the repository allowed to read the clock, and giving it
// a name makes the derogation visible in review.
func SystemClock() ports.Now { return time.Now }
