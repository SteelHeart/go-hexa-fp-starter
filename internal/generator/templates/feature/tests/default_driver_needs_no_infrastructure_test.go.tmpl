// Package tests exercises the {{.Dir}} module as a BLACK BOX, through its
// composition root, exactly like the composition root of the binary will.
//
// These tests are the last net: they verify what no domain test and no use case
// test can see, namely that the MOUNTING itself is correct.
package tests

import (
	"context"
	"testing"
	"time"

	{{.Package}} "{{.Module}}/internal/modules/{{.Dir}}"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestDefaultDriverNeedsNoInfrastructure: the module mounts and works with no
// database, no cache, no container.
//
// This is the central promise of the starter, and it only holds if it is
// verified on EVERY module: one single module whose default driver required
// PostgreSQL is enough for `hexa new` then `go run` to stop starting — and that
// would be discovered at the user's, not here.
func TestDefaultDriverNeedsNoInfrastructure(t *testing.T) {
	t.Parallel()

	module, err := {{.Package}}.New("", {{.Package}}.Deps{
		GenerateID: func() domain.RecordID { return "id-1" },
		Now:        func() time.Time { return time.Unix(0, 0).UTC() },
	})
	if err != nil {
		t.Fatalf("the default driver must mount with no infrastructure: %v", err)
	}

	record, failure, ok := module.Create(context.Background(), "abc-123").Get()
	if !ok {
		t.Fatalf("creation refused: %v", failure)
	}
	if record.Reference.String() != "ABC-123" {
		t.Errorf("reference = %q, want the normalised form", record.Reference)
	}

	// The second call on the same reference must be refused by the DRIVER: it
	// is the one holding the lock, so it alone can settle it.
	if _, _, ok := module.Create(context.Background(), "ABC-123").Get(); ok {
		t.Error("a duplicate reference should have been refused")
	}
}
