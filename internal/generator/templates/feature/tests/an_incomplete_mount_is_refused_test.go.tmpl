package tests

import (
	"context"
	"errors"
	"testing"
	"time"

	{{.Package}} "{{.Module}}/internal/modules/{{.Dir}}"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestAnIncompleteMountIsRefused: an unknown driver and a missing dependency
// both refuse the construction, each one naming itself.
//
// Deny by default. A typo in a driver name is never resolved into "the closest
// one"; and a forgotten dependency must fail at MOUNT time, not on the first
// real request — that is, in production, with a nil pointer stack trace that
// does not say which one was missing.
func TestAnIncompleteMountIsRefused(t *testing.T) {
	t.Parallel()

	complete := {{.Package}}.Deps{
		GenerateID: func() domain.RecordID { return "id-1" },
		Now:        func() time.Time { return time.Unix(0, 0).UTC() },
	}

	if _, err := {{.Package}}.New("cassandre", complete); err == nil {
		t.Error("an unknown driver should have refused the mount")
	}

	if _, err := {{.Package}}.New("", {{.Package}}.Deps{Now: complete.Now}); !errors.Is(err, {{.Package}}.ErrMissingDependency) {
		t.Errorf("a missing dependency should have been refused, got: %v", err)
	}

	// The disabled module, for its part, ALWAYS mounts and refuses when called:
	// that is what lets a surface exist and answer clearly, rather than failing
	// the whole start-up for a module nobody enabled.
	_, err, ok := {{.Package}}.Disabled().Create(context.Background(), "ABC-123").Get()
	if ok {
		t.Fatal("a disabled module should have refused")
	}
	if err.Code != domain.CodeUnavailable {
		t.Errorf("code = %q, want %q", err.Code, domain.CodeUnavailable)
	}
	if !errors.Is(err.Cause(), {{.Package}}.ErrDisabled) {
		t.Error("the refusal must name its cause, otherwise the operator hunts for an outage")
	}
}
