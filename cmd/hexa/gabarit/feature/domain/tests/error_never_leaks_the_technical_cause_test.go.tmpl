package tests

import (
	"errors"
	"strings"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestErrorNeverLeaksTheTechnicalCause : la cause technique est journalisable,
// jamais lisible dans le message rendu.
//
// Une erreur de pilote renvoyée à l'appelant est une fuite de structure : un nom
// de table, un nom de contrainte, parfois un fragment de requête. Le message
// utilisateur et le détail technique sont donc deux chemins distincts, et ce test
// vérifie qu'ils ne se rejoignent nulle part.
//
// Il vérifie aussi que `WithCause` et `WithField` rendent des COPIES : sinon,
// enrichir une erreur en modifierait une autre déjà partie ailleurs.
func TestErrorNeverLeaksTheTechnicalCause(t *testing.T) {
	t.Parallel()

	secret := errors.New("pq: duplicate key value violates unique constraint \"records_reference_key\"")
	base := domain.NewError(domain.CodeInternal, "une erreur interne est survenue")
	enrichie := base.WithCause(secret).WithField("reference")

	if strings.Contains(enrichie.Error(), "constraint") {
		t.Errorf("le message rendu contient le détail technique: %q", enrichie.Error())
	}
	if !errors.Is(enrichie.Cause(), secret) {
		t.Error("la cause doit rester accessible pour la journalisation")
	}
	if base.Cause() != nil || base.Field != "" {
		t.Error("l'erreur d'origine a été mutée : WithCause/WithField doivent copier")
	}
	if !strings.Contains(enrichie.Error(), "reference") {
		t.Errorf("le champ fautif doit apparaître: %q", enrichie.Error())
	}
}
