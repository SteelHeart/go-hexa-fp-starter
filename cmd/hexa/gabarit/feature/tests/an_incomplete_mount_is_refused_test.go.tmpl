package tests

import (
	"context"
	"errors"
	"testing"
	"time"

	{{.Package}} "{{.Module}}/internal/modules/{{.Dir}}"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
)

// TestAnIncompleteMountIsRefused : un pilote inconnu et une dépendance absente
// refusent la construction, chacun en se nommant.
//
// Deny par défaut. Une faute de frappe dans un pilote ne se résout jamais en
// « le plus proche » ; et une dépendance oubliée doit échouer au MONTAGE, pas à
// la première requête réelle — c'est-à-dire en production, avec une trace de
// pointeur nil qui ne dit pas laquelle manquait.
func TestAnIncompleteMountIsRefused(t *testing.T) {
	t.Parallel()

	completes := {{.Package}}.Deps{
		GenerateID: func() domain.RecordID { return "id-1" },
		Now:        func() time.Time { return time.Unix(0, 0).UTC() },
	}

	if _, err := {{.Package}}.New("cassandre", completes); err == nil {
		t.Error("un pilote inconnu devait refuser le montage")
	}

	if _, err := {{.Package}}.New("", {{.Package}}.Deps{Now: completes.Now}); !errors.Is(err, {{.Package}}.ErrMissingDependency) {
		t.Errorf("une dépendance absente devait être refusée, obtenu: %v", err)
	}

	// Le module désactivé, lui, se monte TOUJOURS et refuse à l'appel : c'est ce
	// qui permet à une surface d'exister et de répondre clairement, plutôt que de
	// faire échouer le démarrage entier pour un module que personne n'a activé.
	_, err, ok := {{.Package}}.Disabled().Create(context.Background(), "ABC-123").Get()
	if ok {
		t.Fatal("un module désactivé devait refuser")
	}
	if err.Code != domain.CodeUnavailable {
		t.Errorf("code = %q, attendu %q", err.Code, domain.CodeUnavailable)
	}
	if !errors.Is(err.Cause(), {{.Package}}.ErrDisabled) {
		t.Error("le refus doit nommer sa cause, sinon l'exploitant cherche une panne")
	}
}
