package tests

import (
	"context"
	"testing"

	"{{.Module}}/internal/modules/{{.Dir}}/application"
	"{{.Module}}/internal/modules/{{.Dir}}/domain"
	"{{.Module}}/internal/pkg/result"
)

// TestInvalidInputTouchesNoPort : une entrée invalide n'atteint AUCUN port.
//
// C'est la propriété que le court-circuit du pipeline est censé garantir, et
// elle se constate plutôt qu'elle ne se suppose : les deux ports sont remplacés
// par des closures qui font échouer le test si on les appelle.
//
// Sans ce test, une inversion d'étapes — vérifier l'unicité avant de valider —
// passerait inaperçue. Elle enverrait une requête au stockage pour chaque saisie
// fautive, ce qui est un coût, et surtout une surface d'attaque gratuite.
func TestInvalidInputTouchesNoPort(t *testing.T) {
	t.Parallel()

	deps := depsQuiPassent()
	deps.ReferenceIsTaken = func(context.Context, domain.Reference) result.Result[bool, domain.Error] {
		t.Error("l'unicité ne doit pas être interrogée sur une entrée invalide")
		return result.Ok[bool, domain.Error](false)
	}
	deps.SaveRecord = func(_ context.Context, r domain.Record) result.Result[domain.Record, domain.Error] {
		t.Error("rien ne doit être écrit sur une entrée invalide")
		return result.Ok[domain.Record, domain.Error](r)
	}

	err := echec(t, application.NewCreateRecord(deps)(context.Background(), "  "))
	if err.Code != domain.CodeInvalidReference {
		t.Errorf("code = %q, attendu %q", err.Code, domain.CodeInvalidReference)
	}
}
